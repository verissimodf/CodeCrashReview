# CodeCrashReview .gitignore

# Environment
.env
.env.local
.env.*.local

# Dependencies
node_modules/
vendor/
frontend/node_modules/
backend/vendor/

# Build outputs
frontend/build/
frontend/.svelte-kit/
backend/bin/
backend/tmp/
backend/coverage.out

# Docker
docker-compose.override.yml

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/
*.lcov

# Database
*.sqlite
*.db
*.sql
!backend/migrations/*.sql
!backend/internal/database/queries/*.sql

# Secrets
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/

# Terraform
*.tfstate
*.tfstate.*
.tfplan

# Kubernetes
kubeconfig

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Language specific
# Go
*.exe
*.test
*.prof

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.pytest_cache/

# Rust
target/
Cargo.lock

# Java
*.class
*.jar
*.war
*.ear
target/

# C++
*.o
*.obj
*.a
*.so
*.dll
*.lib

# Monaco Editor
.monaco/

# FreeLLM models
models/
ollama/

# Monitoring
prometheus_data/
grafana_data/
loki_data/

# Backup
*.bak
*.backup

# Misc
*.orig
*.rej
artifacts/
