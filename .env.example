# CodeCrashReview Environment Configuration
# Copy to .env and adjust values

# ===========================================
# Database
# ===========================================
POSTGRES_USER=codecrash
POSTGRES_PASSWORD=codecrash
POSTGRES_DB=codecrash
DATABASE_URL=postgres://codecrash:codecrash@localhost:5432/codecrash?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# ===========================================
# Authentication
# ===========================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your-256-bit-secret-change-in-production
JWT_EXPIRY=24h

# Argon2id parameters (OWASP recommended minimums)
ARGON2_TIME=3
ARGON2_MEMORY=65536
ARGON2_THREADS=4
ARGON2_KEYLEN=32

# ===========================================
# FreeLLM-Local (Ollama/vLLM/TGI)
# ===========================================
# OpenAI-compatible endpoint
FREELLM_BASE_URL=http://localhost:11434/v1
FREELLM_API_KEY=ollama

# Default model for agents (must be pulled in Ollama)
# Recommended models (pull with: ollama pull <model>):
#   - codellama:34b (best for code, 19GB)
#   - codellama:13b (good balance, 7GB)
#   - deepseek-coder:33b (excellent, 19GB)
#   - deepseek-coder:6.7b (fast, 4GB)
#   - qwen2.5-coder:32b (strong, 19GB)
#   - qwen2.5-coder:7b (fast, 4GB)
#   - starcoder2:15b (good, 9GB)
DEFAULT_MODEL=codellama:34b

# Per-agent model overrides (optional)
# AGENT_SENTINEL_MODEL=deepseek-coder:33b
# AGENT_OPTIMIZER_MODEL=codellama:34b
# AGENT_REFACTOR_MODEL=qwen2.5-coder:32b
# AGENT_GUARDIAN_MODEL=starcoder2:15b
# AGENT_DOCUBOT_MODEL=deepseek-coder:6.7b
# AGENT_POLYGLOT_MODEL=codellama:13b

# ===========================================
# Docker / Sandbox
# ===========================================
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_NETWORK=codecrash-sandbox
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_PIDS_LIMIT=100

# Seccomp profile (default: restrictive)
# SANDBOX_SECCOMP_PROFILE=./backend/configs/seccomp-default.json

# ===========================================
# Matchmaking
# ===========================================
ELO_K_FACTOR=32
GLICKO_TAU=0.5
MATCH_TIMEOUT_SECONDS=300
QUEUE_CHECK_INTERVAL_MS=5000

# Rating bounds
MIN_RATING=100
MAX_RATING=3000
DEFAULT_RATING=1200

# Queue matching range (±rating)
MATCHMAKING_RANGE=200

# ===========================================
# Frontend
# ===========================================
PUBLIC_WS_URL=ws://localhost:8080/ws
PUBLIC_API_URL=http://localhost:8080/api

# ===========================================
# Backend Server
# ===========================================
GIN_MODE=debug
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=debug
LOG_FORMAT=json

# ===========================================
# Features Flags
# ===========================================
ENABLE_SPECTATOR_MODE=true
ENABLE_REPLAY_SYSTEM=true
ENABLE_CHALLENGE_TEMPLATES=true
ENABLE_SNIPPET_IMPORT=true
ENABLE_AGENT_ANALYTICS=true