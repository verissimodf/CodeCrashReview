    "svelte-chartjs": "^3.1.0",
    "svelte-motion": "^0.11.0",
    "svelte-sonner": "^0.3.0",
    "svelte-use-form": "^1.0.0",
    "tailwind-merge": "^2.1.0",
    "uplot": "^1.6.0",
